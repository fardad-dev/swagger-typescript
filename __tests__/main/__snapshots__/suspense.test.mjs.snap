/**
 * Get active connections ordered by Transactions count [Feature just allowed
 * for the business users]
 */
export const useGetBusinessUserConnectionActive = (
  queryParams?: GetBusinessUserConnectionActiveQueryParams,
  options?: SwaggerTypescriptUseSuspenseInfiniteQueryOptions<
    SubUserConnectionApiModel[]
  >,
  configOverride?: AxiosRequestConfig,
) => {
  const { extraQueryKey, ...queryOptions } = options || {};
  const { key, fun } = useGetBusinessUserConnectionActive.info(
    queryParams,
    configOverride,
    extraQueryKey,
  );

  const {
    data: { pages } = {},
    data,
    ...rest
  } = useSuspenseInfiniteQuery({
    queryKey: key,
    queryFn: ({ pageParam }) => fun({ page: pageParam }),
    initialPageParam: 1,
    getNextPageParam: (_lastPage, allPages) => allPages.length + 1,
    ...(queryOptions as any),
  });

